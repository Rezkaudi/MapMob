# Base URL of the backend API.
NG_APP_API_BASE_URL=http://localhost:3000/api

# When true, the app reads from local JSON fixtures instead of the API above.
# Flip to false once the real endpoints exist. See src/mock/README.md.
NG_APP_USE_MOCK_API=true

# Where the merchant login's "تواصل مع إدارة MapMob" link goes: mailto:, tel: or a web page.
# Optional; defaults to mailto:support@mapmob.com.
NG_APP_MERCHANT_SUPPORT_URL=mailto:support@mapmob.com
