# Base URL of the backend API.
NG_APP_API_BASE_URL=https://api.mapmob.com.co

# When true, every feature reads local mock data. When false, the features listed in
# src/app/core/config/live-api-features.ts use the API above; the rest keep their mocks.
NG_APP_USE_MOCK_API=false

# Where the merchant login's "تواصل مع إدارة MapMob" link goes: mailto:, tel: or a web page.
# Optional; defaults to mailto:support@mapmob.com.
NG_APP_MERCHANT_SUPPORT_URL=mailto:support@mapmob.com
